/* Begin add by jin.wang for task 2064 at 2021-10-25 */
&i2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;

	bq25601:bq25601@6B {
		compatible = "mediatek,bq25601";
		reg = <0x6b>;
		id = <0x5>;
		status = "okay";
		charger_name = "primary_chg";
		alias_name = "bq25601";
		bq25601,en_gpio = <&pio 165 0x0>;
		bq25601,intr_gpio = <&pio 12 0x0>;
		eint_name = "bq25601_intr";
	};
};
