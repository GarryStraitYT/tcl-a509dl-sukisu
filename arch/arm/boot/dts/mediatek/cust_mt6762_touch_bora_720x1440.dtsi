/*begin add by wenhao.deng for task 11388151 on 20210729*/

/* TOUCH start */
&spi0 {
        #address-cells = <1>;
        #size-cells = <0>;
		mediatek,pad-select = <0>, <1>, <2>; 
        status = "okay";
		tct_focaltech_tp@0 {
			compatible = "focaltech,fts";
			reg = <0>;
			spi-max-frequency = <10000000>;
			interrupt-parent = <&pio>;
			interrupts = <0 0x2008>;

			/* ft8006s special */
			focaltech,reset-gpio = <&pio 174 0x00>;
			focaltech,irq-gpio = <&pio 0 0x00>;
			focaltech,max-touch-number = <5>;
			focaltech,display-coords =  <0 0 720 1440>;
         };


		gc7202_tp@1 {
			status = "okay";
			compatible = "gcore,touchscreen";
			reg = <1>;
			spi-max-frequency = <10000000>;
			gcore,rst-gpio = <&pio 174 0x00>;
			gcore,irq-gpio = <&pio 0 0x00>;
		};

		chipone_tp@2 {
			status = "okay";
			compatible = "chipone-tddi";
			reg = <2>;
			spi-max-frequency = <10000000>;
			chipone,rst-gpio = <&pio 174 0x00>;
			chipone,irq-gpio = <&pio 0 0x00>;
			chipone,x-res = <720>;
			chipone,y-res = <1440>;
		/*selftest settings start*/
			chipone,test-reset-pin;
			chipone,test-rawdata;
			chipone,test-rawdata-frames = <1>;
			chipone,rawdata-min = <1521>;
			chipone,rawdata-max = <3591>;
			chipone,test-noise;
			chipone,test-noise-frames = <50>;
			chipone,noise-max = <76>;
			chipone,test-open;
			chipone,open-min = <3465>;
			chipone,test-short;
			chipone,short-min = <500>;
			chipone,test-compensate-cap;
			chipone,compensate-cap-min = <1>;
			chipone,compensate-cap-max = <126>;
		/*selftest settings end*/
		};
};

/* TOUCH end */




