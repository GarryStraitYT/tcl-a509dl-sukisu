//Begin modified by liangjiaqiang for MODEL3-1896 on 2022-09-15
&i2c0 {
	/* AWINIC AW87359 Smart K PA */
	aw87xxx_pa_58@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		dev_index = < 0 >;
		monitor-flag = <0>; //1=enable
		monitor-timer-val = <3000>; //time interval, ms
		monitor-timer-count-max = <5>; //counts for average
		status = "okay";
	};

	aw87xxx_pa_59@59 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x59>;
		dev_index = < 1 >;
		monitor-flag = <0>; //1=enable
		monitor-timer-val = <3000>; //time interval, ms
		monitor-timer-count-max = <5>; //counts for average
		status = "okay";
	};
	/* AWINIC AW87359 Smart K PA End */
};
//End modified by liangjiaqiang for MODEL3-1896 on 2022-09-15
#include "model_3/cust.dtsi"

/*Begin ersen.shang for [Task][ 11425156][cruze/cruze pro camera bring up] 202108*/
/*End   ersen.shang for [Task][ 11425156][cruze/cruze pro camera bring up] 202108*/

//#include "mediatek/cust_mt6765_touch_1080x1920.dtsi"

&mtkfb {
	pinctrl-names = "default","lcm_rst_out0_gpio","lcm_rst_out1_gpio";
	pinctrl-0 = <&mtkfb_pins_default>;
	pinctrl-1 = <&mtkfb_pins_lcd_rst0>;
	pinctrl-2 = <&mtkfb_pins_lcd_rst1>;
	status = "okay";
};
&pio {
	mtkfb_pins_default: mtkfbdefault {
	};

	mtkfb_pins_lcd_rst0: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcd_rst1: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-high;
		};
	};

};

