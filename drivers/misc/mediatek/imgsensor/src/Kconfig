config TCT_CAM_DRIVER_SUPPORT
	bool TCT_CAM_DRIVER_SUPPORT

config TCT_CAMERA_PROJECT_BUFFALOTMO
 	tristate "build project name of Buffalo"
 	default n
 	help
 	  This option enables when build Buffalo.

