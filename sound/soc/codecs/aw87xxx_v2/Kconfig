config SND_SOC_AW87XXX_V2
	tristate "SoC Audio for awinic AW87XXX Smart K PA"
	depends on I2C
	help
	  This option enables support for AW87XXX Smart K PA.

config SND_SOC_AW87XXX_CRUZE_V2
	tristate "SoC Audio for awinic AW87XXX for cruze family"
	depends on I2C
	help
	  This option enables support for AW87XXX for cruze family.